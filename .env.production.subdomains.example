# ============================================
# Instify Platform - Production Environment
# Subdomain Architecture Configuration
# ============================================

# ============================================
# Server Configuration
# ============================================
NODE_ENV=production
SERVER_IP=your.server.ip.address
DOMAIN=instify.net

# ============================================
# Database Configuration
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=instify_production
DB_USER=instify_prod
DB_PASSWORD=your_secure_database_password_here

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379

# ============================================
# Application URLs (Subdomain Architecture)
# ============================================
NEXTAUTH_URL=https://instify.net
NEXTAUTH_SECRET=your_nextauth_secret_32_chars_min

# ============================================
# Authentication (Clerk)
# ============================================
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key_here

# ============================================
# AI Services
# ============================================
# OpenAI (Required for Voice AI)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional AI Services
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_key_here
CARTESIA_API_KEY=your_cartesia_key_here
DEEPGRAM_API_KEY=your_deepgram_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ============================================
# LiveKit Configuration (Subdomain)
# ============================================
LIVEKIT_URL=wss://livekit.instify.net
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ============================================
# n8n Configuration (Subdomain)
# ============================================
N8N_HOST=n8n.instify.net
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=your_secure_n8n_password_here
N8N_WEBHOOK_URL=https://n8n.instify.net/webhook

# ============================================
# Backup Configuration
# ============================================
BACKUP_SCHEDULE=@daily
TIMEZONE=UTC

# ============================================
# Monitoring & Logging
# ============================================
LOG_LEVEL=info
ENABLE_METRICS=true

# ============================================
# Security
# ============================================
JWT_SECRET=your_jwt_secret_64_chars_minimum_for_production_security
ENCRYPTION_KEY=your_encryption_key_32_chars_minimum

# ============================================
# Email Configuration (Optional)
# ============================================
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=admin@instify.net

# ============================================
# External Services (Optional)
# ============================================
WEBHOOK_SECRET=your_webhook_secret_here
API_RATE_LIMIT=100

# ============================================
# Development/Debug (Set to false in production)
# ============================================
DEBUG=false
VERBOSE_LOGGING=false
