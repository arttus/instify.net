# ============================================
# Local Development Environment
# Copy this to .env.local for development
# ============================================

# ============================================
# Environment Configuration
# ============================================
NODE_ENV=development
ENVIRONMENT=local
DOMAIN=localhost
PORT=3000

# ============================================
# Database Configuration (Local)
# ============================================
DB_PASSWORD=dev_password_123
DB_PORT=5432
DATABASE_URL=postgresql://odeuo:dev_password_123@localhost:5432/odeuo_dev

# ============================================
# Redis Configuration (Local)
# ============================================
REDIS_PASSWORD=dev_redis_123
REDIS_PORT=6379
REDIS_URL=redis://:dev_redis_123@localhost:6379

# ============================================
# Backup Configuration
# ============================================
BACKUP_SCHEDULE=@hourly

# ============================================
# Authentication (Clerk - Development)
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_dev_key_here
CLERK_SECRET_KEY=sk_test_your_dev_secret_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
CLERK_WEBHOOK_SECRET=whsec_dev_webhook_secret

# ============================================
# Payment Processing (Stripe - Test Mode)
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here
STRIPE_SECRET_KEY=sk_test_your_test_secret_here
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret

# Test Product IDs
STRIPE_BASIC_PRICE_ID=price_test_basic
STRIPE_PRO_PRICE_ID=price_test_pro
STRIPE_ENTERPRISE_PRICE_ID=price_test_enterprise

# ============================================
# AI Services (Development)
# ============================================
OPENAI_API_KEY=sk-your_dev_openai_key_here
ANTHROPIC_API_KEY=sk-ant-your_dev_anthropic_key_here

# ============================================
# Communication Services (Test Mode)
# ============================================
TWILIO_ACCOUNT_SID=ACtest_account_sid
TWILIO_AUTH_TOKEN=test_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# Meta/Instagram (Development)
META_APP_ID=your_dev_app_id
META_APP_SECRET=your_dev_app_secret
META_WEBHOOK_VERIFY_TOKEN=dev_verify_token

# ============================================
# Voice AI (Livekit - Local)
# ============================================
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# ============================================
# Automation (n8n - Local)
# ============================================
N8N_USER=admin
N8N_PASSWORD=dev_password_123
N8N_WEBHOOK_URL=http://localhost:5678

# ============================================
# Security (Development)
# ============================================
NEXTAUTH_SECRET=dev_nextauth_secret_not_secure
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=dev_jwt_secret_not_secure

# ============================================
# Development Settings
# ============================================
LOG_LEVEL=debug
DEBUG=true
SKIP_ENV_VALIDATION=true
WATCHPACK_POLLING=true

# Disable external services for local development
DISABLE_WEBHOOKS=true
MOCK_EXTERNAL_APIS=true
