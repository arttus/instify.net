# ============================================
# LiveKit Agents Production Dockerfile
# Voice AI Agents for ODEUO Platform (Node.js/TypeScript)
# ============================================

FROM node:20-slim as base

# ============================================
# System Dependencies
# ============================================
RUN apt-get update && apt-get install -y \
    # Build tools
    build-essential \
    pkg-config \
    python3 \
    # Audio libraries
    libportaudio2 \
    libportaudiocpp0 \
    portaudio19-dev \
    # Video libraries (for future multimodal support)
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libavfilter-dev \
    # System utilities
    curl \
    wget \
    # Cleanup
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ============================================
# Node.js Environment
# ============================================
# Set working directory
WORKDIR /app

# Install pnpm for fast package management
RUN npm install -g pnpm

# Copy package files first for better caching
COPY package.json pnpm-lock.yaml* ./

# Install Node.js dependencies (production only)
RUN pnpm install --prod --frozen-lockfile

# ============================================
# Build Stage
# ============================================
FROM base as builder

# Install all dependencies including dev dependencies for building
RUN pnpm install --frozen-lockfile

# Copy TypeScript configuration and source code
COPY tsconfig.json tsup.config.ts ./
COPY src/ ./src/
COPY config/ ./config/

# Build the TypeScript application
RUN pnpm build

# ============================================
# Production Stage
# ============================================
FROM base as production

# Copy built application from builder stage
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY config/ ./config/
COPY start.sh ./start.sh

# Create necessary directories
RUN mkdir -p /app/logs /app/models /app/data

# Make startup script executable
RUN chmod +x /app/start.sh

# ============================================
# Production Configuration
# ============================================
# Set environment variables
ENV NODE_ENV=production
ENV AGENT_MODE=production
ENV AGENT_LOG_LEVEL=info

# Create non-root user for security
RUN useradd -m -u 1001 agent && \
    chown -R agent:agent /app

# Switch to non-root user
USER agent

# ============================================
# Health Check
# ============================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# ============================================
# Entry Point
# ============================================
# Expose ports
EXPOSE 8000 8001

# Default command
CMD ["./start.sh"]
