# ============================================
# ODEUO Infrastructure Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# For production, copy to .env.production

# ============================================
# Environment Configuration
# ============================================
NODE_ENV=development
ENVIRONMENT=local
DOMAIN=localhost
PORT=3000

# ============================================
# Database Configuration
# ============================================
DB_PASSWORD=your_secure_db_password_here
DB_PORT=5432
DATABASE_URL=postgresql://odeuo:${DB_PASSWORD}@postgres:5432/odeuo

# For external database (production alternative)
# DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ============================================
# Backup Configuration
# ============================================
BACKUP_SCHEDULE=@daily
# Options: @yearly, @monthly, @weekly, @daily, @hourly
# Or cron format: "0 2 * * *" (2 AM daily)

# ============================================
# Authentication (Clerk)
# ============================================
# Get these from https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Clerk Webhook Secret (for syncing users/orgs)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# Payment Processing (Stripe)
# ============================================
# Get these from https://stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Product IDs (create these in Stripe Dashboard)
STRIPE_BASIC_PRICE_ID=price_basic_plan_id
STRIPE_PRO_PRICE_ID=price_pro_plan_id
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_plan_id

# ============================================
# AI Services
# ============================================
# OpenAI API (https://openai.com)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic API (https://anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# ============================================
# Communication Services
# ============================================
# Twilio (https://twilio.com)
TWILIO_ACCOUNT_SID=ACyour_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Instagram/Meta (https://developers.facebook.com)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# ============================================
# Voice AI (Livekit)
# ============================================
# Generate these with: openssl rand -hex 32
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_URL=ws://livekit:7880

# For production, use your domain
# LIVEKIT_URL=wss://your-domain.com/livekit

# LiveKit Agents Webhook Secret
LIVEKIT_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# Advanced AI Services (Optional)
# ============================================
# AssemblyAI (Advanced STT) - https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Cartesia (Advanced TTS) - https://cartesia.ai/
CARTESIA_API_KEY=your_cartesia_api_key_here

# Deepgram (Advanced STT) - https://deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs (Advanced TTS) - https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Google Cloud Speech
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-credentials.json

# ============================================
# CRM (Twenty)
# ============================================
# Twenty Database Configuration
TWENTY_DB_USER=twenty
TWENTY_DB_PASSWORD=your_secure_twenty_db_password_here
TWENTY_DB_NAME=twenty

# Twenty Security
TWENTY_APP_SECRET=your_secure_twenty_app_secret_here

# Twenty URLs
TWENTY_SERVER_URL=http://localhost:3002
TWENTY_FRONT_BASE_URL=http://localhost:3002

# For production, use your domain
# TWENTY_SERVER_URL=https://crm.your-domain.com
# TWENTY_FRONT_BASE_URL=https://crm.your-domain.com

# Twenty Logging
TWENTY_LOG_LEVEL=debug
# Options: error, warn, info, debug

# ============================================
# Automation (n8n)
# ============================================
N8N_USER=admin
N8N_PASSWORD=your_secure_n8n_password_here
N8N_WEBHOOK_URL=http://n8n:5678

# For production, use your domain
# N8N_WEBHOOK_URL=https://your-domain.com/n8n

# ============================================
# Security
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# For production
# NEXTAUTH_URL=https://your-domain.com

# JWT Secret for API authentication
JWT_SECRET=your_jwt_secret_here

# ============================================
# Monitoring & Logging
# ============================================
LOG_LEVEL=info
# Options: error, warn, info, debug

# Sentry (optional - for error tracking)
SENTRY_DSN=https://your_sentry_dsn_here

# ============================================
# File Storage
# ============================================
# DigitalOcean Spaces (S3-compatible)
DO_SPACES_KEY=your_spaces_key_here
DO_SPACES_SECRET=your_spaces_secret_here
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=odeuo-storage

# Alternative: AWS S3
# AWS_ACCESS_KEY_ID=your_aws_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_here
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=odeuo-storage

# ============================================
# Development Settings
# ============================================
# Set to true for development
DEBUG=false
SKIP_ENV_VALIDATION=false

# Hot reload for development
WATCHPACK_POLLING=true
