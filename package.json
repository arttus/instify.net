{
  "name": "instify-infrastructure",
  "version": "1.0.0",
  "description": "Multi-tenant B2B SaaS infrastructure for Instify AI automation platform",
  "private": true,
  "scripts": {
    "dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "dev:detached": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "dev:logs": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml logs -f",
    "dev:down": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "dev:clean": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml down -v --remove-orphans",
    
    "prod": "docker-compose up -d --build",
    "prod:logs": "docker-compose logs -f",
    "prod:down": "docker-compose down",
    "prod:restart": "docker-compose restart",

    "monitoring": "docker-compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d",
    "monitoring:down": "docker-compose -f docker-compose.yml -f docker-compose.monitoring.yml down",
    
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx drizzle/seeds/dev-seed.ts",
    "db:clean": "tsx drizzle/seeds/dev-seed.ts --clean",
    "db:reset": "npm run db:clean && npm run db:migrate && npm run db:seed",
    
    "backup:create": "./scripts/backup.sh create",
    "backup:restore": "./scripts/backup.sh restore",
    "backup:list": "./scripts/backup.sh list",
    
    "health": "./scripts/health-check.sh",
    "logs": "./scripts/logs.sh",
    "deploy": "./scripts/deploy.sh",
    
    "setup": "./setup.sh",
    "setup:local": "./setup.sh local",
    "setup:prod": "./setup.sh production",
    
    "lint": "eslint . --ext .ts,.js",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "drizzle-orm": "^0.29.0",
    "postgres": "^3.4.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "instify",
    "multi-tenant",
    "saas",
    "docker",
    "postgresql",
    "redis",
    "nginx",
    "livekit",
    "n8n",
    "ai-automation"
  ],
  "author": "Instify Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourorg/instify.git"
  }
}
